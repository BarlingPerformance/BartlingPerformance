# Port the API listens on (Render sets this automatically)
PORT=4000

# Where the SQLite file is stored. Point this at a mounted persistent
# disk in production (e.g. Render disk mounted at /var/data).
DB_PATH=./data/bartling.sqlite

# Comma-separated list of allowed frontend origins for CORS.
# Leave unset locally to allow all origins.
CLIENT_ORIGIN=https://your-frontend.onrender.com
